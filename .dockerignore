# Build artifacts
vendor/node_modules/
vendor/package-lock.json

# Git
.git/
.gitignore

# IDE / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Docs (exclude all markdown except docs/ directory)
README.md
LICENSE
*.md
!docs/*.md
# CHANGELOG.md ships at the root for the Help slide-out's Changelog page
# (1.3.10) — without this re-include, the *.md exclusion above strips it
# and the in-app Changelog tab 404s in production.
!CHANGELOG.md
