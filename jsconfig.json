{
  "compilerOptions": {
    "checkJs": true,
    "strict": false,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "./js/*": ["./js/*"]
    },
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true
  },
  "include": ["js/**/*.js"],
  "exclude": ["node_modules", "vendor", "tests"]
}
